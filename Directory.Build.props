<Project>

  <!-- One declaration for the whole workspace. MSBuild imports this into every
       project beneath it before the project body runs, so each project still
       overrides any of these by declaring its own - which is exactly the point:
       a project that needs net10.0-windows or Nullable=annotations says so, and
       one that says nothing inherits the workspace's answer instead of silently
       inheriting nothing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- A warning is a finding the build has already made, so it fails the build rather
       than scrolling past: Nullable=enable above only means something while CS86xx
       stops a build, and the xUnit analyzers only while they stop a test project.
       NuGet's vulnerability audit (NU1901-NU1904) stays a warning, because a new
       advisory against a test-only package is published about the world, not about
       the commit being built, and would turn an unchanged tree red. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
