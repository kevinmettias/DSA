<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests the catalog harness's shared runtime: the notation reader, the case columns, the strategy
       binding, the judge and the answer rendering, over the enrolled solutions and the checked-in
       snapshot. The harness finds the solutions by reflection, so these tests reference them directly. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSAExperimentation.LeetCode.Harness\DSAExperimentation.LeetCode.Harness.csproj" />
    <ProjectReference Include="..\DSAExperimentation.LeetCode.Solutions\DSAExperimentation.LeetCode.Solutions.csproj" />
  </ItemGroup>

</Project>
