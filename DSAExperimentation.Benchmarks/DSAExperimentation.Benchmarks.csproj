<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DSAExperimentation.Benchmarks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <!-- Every benchmark class declares [Params], [GlobalSetup] and [Benchmark], so the namespace
       they come from is imported once here rather than at the top of 1,100 files. The memory
       diagnoser every class used to carry is BenchmarkConfig's to add, for the same reason. -->
  <ItemGroup>
    <Using Include="BenchmarkDotNet.Attributes" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSAExperimentation\DSAExperimentation.csproj" />
    <ProjectReference Include="..\DSAExperimentation.LeetCode.Solutions\DSAExperimentation.LeetCode.Solutions.csproj" />
    <ProjectReference Include="..\DSAExperimentation.LeetCode.Catalog\DSAExperimentation.LeetCode.Catalog.csproj" />
    <ProjectReference Include="..\DSAExperimentation.LeetCode.Harness\DSAExperimentation.LeetCode.Harness.csproj" />
  </ItemGroup>

  <!-- The catalog benchmark classes are written at build time, one per solution that names its LeetCode
       question (ARCHITECTURE 17.13), so the generator runs as an analyzer and is never referenced as
       an assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\DSAExperimentation.Benchmarks.Generators\DSAExperimentation.Benchmarks.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
