<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Every package this workspace uses is on nuget.org, so that is the only source it
       restores from. Clearing first drops whatever feeds the machine-wide config adds,
       which keeps a restore here the same on every machine and in CI - and with central
       package management on, a second inherited feed is NU1507, an error under
       TreatWarningsAsErrors. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
